---
// 最終更新日＝ビルドした日（日本時間）。Cloudflare Pages は main に push するたびにビルドするので、公開した日になる
const today = new Date(Date.now() + 9 * 60 * 60 * 1000).toISOString().slice(0, 10); // 例: 2026-11-27
const lastUpdate = today.replaceAll('-', '.');
const currentYear = today.slice(0, 4);

// MDI content-cut（はさみ）
const scissorsPath = 'M19 3l-6 6l2 2l7-7V3m-10 9.5a.5.5 0 0 1-.5-.5a.5.5 0 0 1 .5-.5a.5.5 0 0 1 .5.5a.5.5 0 0 1-.5.5M6 20a2 2 0 0 1-2-2c0-1.11.9-2 2-2a2 2 0 0 1 2 2c0 1.11-.9 2-2 2M6 8a2 2 0 0 1-2-2c0-1.11.9-2 2-2a2 2 0 0 1 2 2c0 1.11-.9 2-2 2m3.64-.36c.23-.5.36-1.05.36-1.64a4 4 0 0 0-4-4a4 4 0 0 0-4 4a4 4 0 0 0 4 4c.59 0 1.14-.13 1.64-.36L10 12l-2.36 2.36C7.14 14.13 6.59 14 6 14a4 4 0 0 0-4 4a4 4 0 0 0 4 4a4 4 0 0 0 4-4c0-.59-.13-1.14-.36-1.64L12 14l7 7h3v-1z';
---

{/* 切符の半券。点線が切り取り線で、トップの切符と同じ書き方で発券情報を並べる */}
<footer class="ticket-stub mt-32 pb-16">
  <div class="stub-cut" aria-hidden="true">
    <svg viewBox="0 0 24 24" width="16" height="16"><path fill="currentColor" d={scissorsPath} /></svg>
    <span></span>
  </div>
  <div class="max-w-3xl mx-auto px-6 pt-10 text-center">
    <p class="stub-meta">
      <span class="whitespace-nowrap">yonu.work</span> / <span class="whitespace-nowrap">LAST UPDATE: <time datetime={today}>{lastUpdate}</time></span>
      {/* アクセスカウンター（半券の通し番号）。数が取れたときだけスクリプトで出す */}
      <span data-visit-counter hidden> / <span class="whitespace-nowrap" title="訪問者数（同じブラウザからは1日1回まで）">No. <span data-visit-count></span></span></span>
    </p>
    <p class="mt-2 text-[11px] text-[var(--text-muted)] tracking-wider">
      © 2025–{currentYear} yonu33
    </p>
  </div>
</footer>

<script is:inline>
  {
    // アクセスカウンター（functions/api/visits.js）。
    // トップページを開いたときに、同じブラウザからは 1 日 1 回だけ数を 1 増やす（ブラウザには数えた日付だけを残す）。
    // それ以外のとき（同じ日の 2 回目以降や 404 ページ）は数を読むだけ。取れなければ何も出さない。
    // ページの表示を邪魔しないよう、読み込みが終わってから問い合わせる
    const counter = document.querySelector('[data-visit-counter]');
    const KEY = 'visit-counted-on';
    const today = new Date(Date.now() + 9 * 60 * 60 * 1000).toISOString().slice(0, 10); // 日本時間の日付
    let countedToday = false;
    try { countedToday = localStorage.getItem(KEY) === today; } catch {}
    const shouldCount = location.pathname === '/' && !countedToday;

    const show = async () => {
      try {
        const res = await fetch('/api/visits', { method: shouldCount ? 'POST' : 'GET' });
        if (!res.ok) return;
        const { count } = await res.json();
        if (!Number.isFinite(count) || count <= 0) return;
        if (shouldCount) {
          try { localStorage.setItem(KEY, today); } catch {}
        }
        counter.querySelector('[data-visit-count]').textContent = String(count).padStart(6, '0');
        counter.hidden = false;
      } catch {}
    };

    if (counter) {
      if (document.readyState === 'complete') show();
      else window.addEventListener('load', show, { once: true });
    }
  }
</script>

<style>
  .stub-cut {
    display: flex;
    align-items: center;
    gap: .5rem;
    color: var(--text-muted);
  }

  .stub-cut span {
    flex: 1;
    border-top: 1px dashed var(--border-color);
  }

  .stub-meta {
    color: var(--accent-cool);
    font-size: .78rem;
    letter-spacing: .15em;
  }

  @media (max-width: 767px) {
    .stub-meta {
      font-size: .66rem;
      letter-spacing: .06em;
    }
  }
</style>
