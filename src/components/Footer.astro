---
// 最終更新日＝ビルドした日（日本時間）。Cloudflare Pages は main に push するたびにビルドするので、公開した日になる
const today = new Date(Date.now() + 9 * 60 * 60 * 1000).toISOString().slice(0, 10); // 例: 2026-11-27
const lastUpdate = today.replaceAll('-', '.');
const currentYear = today.slice(0, 4);

// MDI content-cut（はさみ）
const scissorsPath = 'M19 3l-6 6l2 2l7-7V3m-10 9.5a.5.5 0 0 1-.5-.5a.5.5 0 0 1 .5-.5a.5.5 0 0 1 .5.5a.5.5 0 0 1-.5.5M6 20a2 2 0 0 1-2-2c0-1.11.9-2 2-2a2 2 0 0 1 2 2c0 1.11-.9 2-2 2M6 8a2 2 0 0 1-2-2c0-1.11.9-2 2-2a2 2 0 0 1 2 2c0 1.11-.9 2-2 2m3.64-.36c.23-.5.36-1.05.36-1.64a4 4 0 0 0-4-4a4 4 0 0 0-4 4a4 4 0 0 0 4 4c.59 0 1.14-.13 1.64-.36L10 12l-2.36 2.36C7.14 14.13 6.59 14 6 14a4 4 0 0 0-4 4a4 4 0 0 0 4 4a4 4 0 0 0 4-4c0-.59-.13-1.14-.36-1.64L12 14l7 7h3v-1z';
---

{/* 切符の半券。点線が切り取り線で、トップの切符と同じ書き方で発券情報を並べる */}
<footer class="ticket-stub mt-32 pb-16">
  <div class="stub-cut" aria-hidden="true">
    <svg viewBox="0 0 24 24" width="16" height="16"><path fill="currentColor" d={scissorsPath} /></svg>
    <span></span>
  </div>
  <div class="max-w-3xl mx-auto px-6 pt-10 text-center">
    <p class="stub-meta">
      <span class="whitespace-nowrap">yonu.work</span> / <span class="whitespace-nowrap">LAST UPDATE: <time datetime={today}>{lastUpdate}</time></span>
    </p>
    <p class="mt-2 text-[11px] text-[var(--text-muted)] tracking-wider">
      © 2025–{currentYear} yonu33
    </p>
  </div>
</footer>

<style>
  .stub-cut {
    display: flex;
    align-items: center;
    gap: .5rem;
    color: var(--text-muted);
  }

  .stub-cut span {
    flex: 1;
    border-top: 1px dashed var(--border-color);
  }

  .stub-meta {
    color: var(--accent-cool);
    font-size: .78rem;
    letter-spacing: .15em;
  }

  @media (max-width: 767px) {
    .stub-meta {
      font-size: .66rem;
      letter-spacing: .06em;
    }
  }
</style>
