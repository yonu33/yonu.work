---
const platformConfig = {
  Qiita: { color: "text-[#55c500]", bgColor: "bg-[#55c500]/10 dark:bg-[#55c500]/20" },
  Zenn:  { color: "text-[#3ea8ff]", bgColor: "bg-[#3ea8ff]/10 dark:bg-[#3ea8ff]/20" },
  note:  { color: "text-[#2cb696]", bgColor: "bg-[#2cb696]/10 dark:bg-[#2cb696]/20" },
  'はてなブログ': { color: "text-[#2c3e50] dark:text-[#d5e3f0]", bgColor: "bg-[#2c3e50]/10 dark:bg-[#d5e3f0]/15" },
  Blog:  { color: "text-[var(--text-main)]", bgColor: "bg-[var(--border-color)]/30" },
};

// サムネイルは画像変換サービス（weserv）で縮小・WebP 化する。
// ただし Qiita の画像（imgix）は URL が長すぎて weserv が失敗するうえ、すでに最適化済みなので直接読み込む。
const toProxyUrl = (thumbnail) => {
  if (!thumbnail) return '';
  try {
    const { hostname } = new URL(thumbnail);
    return hostname.endsWith('imgix.net')
      ? thumbnail
      : `https://images.weserv.nl/?url=${encodeURIComponent(thumbnail)}&w=800&output=webp&af`;
  } catch {
    return '';
  }
};

// ビルド時に Qiita / Zenn / note / はてなブログ から新しい順に取得する（src/lib/articles.js）
import { getArticles } from '../lib/articles.js';
const articles = await getArticles();
---

<div>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-8">
    {articles.map(article => {
      const style = platformConfig[article.platform] || platformConfig.Blog;
      const proxyUrl = toProxyUrl(article.thumbnail);

      return (
        <a href={article.url} target="_blank" rel="noopener noreferrer" class="group block">
          <div class="aspect-video w-full overflow-hidden border border-[var(--border-color)] group-hover:border-[var(--accent-strong)] transition-colors mb-4 bg-[var(--bg-card)] flex items-center justify-center">
            {proxyUrl && (
              <img
                src={proxyUrl}
                alt=""
                loading="lazy"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                onerror="this.hidden = true; this.nextElementSibling.hidden = false;"
              />
            )}
            <span class={`text-2xl font-bold ${style.color}`} aria-hidden="true" hidden={Boolean(proxyUrl)}>{article.platform}</span>
          </div>
          
          <div class="flex items-center gap-2 mb-2">
            <span class={`text-[10px] font-bold px-2 py-0.5 ${style.bgColor} ${style.color}`}>
              {article.platform}
            </span>
            <span class="text-[10px] text-[var(--text-muted)] font-mono">{article.date}</span>
          </div>
          
          <h3 class="text-base md:text-lg font-bold text-[var(--text-main)] group-hover:text-[var(--accent-strong)] transition-colors leading-snug">
            {article.title}
          </h3>
        </a>
      );
    })}
  </div>
</div>