---
const mutualLinks = [
  { 
    name: "柴犬被り 氏", 
    url: "https://memo.shibadogcap.com/"
  },
  { 
    name: "トラマト 氏", 
    url: "https://toramutton.me/"
  },
  {
    name: "えぬぴー 氏",
    url: "https://negapainter.work/"
  },
  {
    name: "そらい 氏",
    url: "https://sudo-sorai.dev/"
  }
];

const getFavicon = (siteUrl) => {
  const domain = new URL(siteUrl).hostname;
  return `https://images.weserv.nl/?url=https://www.google.com/s2/favicons?domain=${domain}&sz=128&lbc=1`;
};

// 「このサイトへのリンク」に載せる情報
const linkKit = [
  { label: 'サイト名', value: 'yonu.work' },
  { label: 'URL', value: 'https://yonu.work/' },
  { label: 'アイコン', value: 'https://yonu.work/favicon.png' },
  { label: '紹介文', value: '会津大学の学生エンジニア yonu のポートフォリオ' },
];
---

<section id="mutual-links" class="mb-16 md:mb-20 scroll-mt-24">
  <div class="section-title mb-6">
    <span>06</span>
    <div>
      <p>MUTUAL LINKS</p>
      <h2>相互リンク</h2>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-3 md:gap-4">
    {mutualLinks.map(site => (
      <a 
        href={site.url} 
        target="_blank"
        rel="noopener noreferrer"
        /* スマホでは p-3 にしてコンテンツ幅を確保、PCでは p-4 */
        class="retro-panel group flex items-center gap-3 md:gap-4 p-3 md:p-4 hover:border-[var(--accent-strong)] transition-colors"
      >
        <div class="w-12 h-12 shrink-0 flex items-center justify-center bg-[var(--bg-page)] overflow-hidden border border-[var(--border-color)]">
          <!-- アイコンが取得できなかったときは、名前の頭文字に差し替える -->
          <img
            src={getFavicon(site.url)}
            alt=""
            class="w-7 h-7 object-contain"
            loading="lazy"
            onerror="this.hidden = true; this.nextElementSibling.hidden = false;"
          />
          <span class="text-lg font-bold text-[var(--accent-strong)]" aria-hidden="true" hidden>{site.name.charAt(0)}</span>
        </div>

        <div class="overflow-hidden">
          <h3 class="font-bold text-sm md:text-base text-[var(--text-main)] truncate group-hover:text-[var(--accent-strong)] transition-colors">
            {site.name}
          </h3>
          <p class="text-[10px] text-[var(--text-muted)] font-mono truncate mt-0.5">
            {site.url.replace(/^https?:\/\//, '').replace(/\/$/, '')}
          </p>
        </div>
      </a>
    ))}
  </div>

  <!-- 相互リンクしてくれる人向けに、このサイトの情報をコピーできるようにする -->
  <div class="retro-panel link-kit mt-6">
    <div class="link-kit-head">
      <img src="/favicon.png" alt="" width="40" height="40" />
      <div>
        <h3>このサイトへのリンク</h3>
        <p>相互リンク歓迎です。下の情報をご自由にお使いください。</p>
      </div>
    </div>
    <dl class="link-kit-rows">
      {linkKit.map(row => (
        <div>
          <dt>{row.label}</dt>
          <dd>
            <code>{row.value}</code>
            <button type="button" data-copy={row.value} aria-label={`${row.label}をコピー`}>コピー</button>
          </dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<script is:inline>
  document.querySelectorAll('.link-kit [data-copy]').forEach(button => {
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy);
        button.textContent = 'コピーしました';
      } catch {
        button.textContent = 'コピーできませんでした';
      }
      setTimeout(() => { button.textContent = 'コピー'; }, 1500);
    });
  });
</script>