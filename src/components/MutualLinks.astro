---
// 相互リンクの一覧とアイコンは src/data/mutualLinks.js で管理する。
// 紹介文はビルド時に各サイトから自動で取得する（取れなければ mutualLinks.js の description）
import { getMutualLinks } from '../lib/mutualLinks.js';
const mutualLinks = await getMutualLinks();

// 「このサイトへのリンク」に載せる情報
const linkKit = [
  { label: 'サイト名', value: 'yonu.work' },
  { label: 'URL', value: 'https://yonu.work/' },
  { label: 'アイコン', value: 'https://yonu.work/favicon.png' },
];
---

<section id="mutual-links" class="mb-16 md:mb-20 scroll-mt-24">
  <div class="section-title mb-6">
    <span>06</span>
    <div>
      <p>MUTUAL LINKS</p>
      <h2>相互リンク</h2>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-3 md:gap-4">
    {mutualLinks.map(site => (
      <a 
        href={site.url} 
        target="_blank"
        rel="noopener noreferrer"
        /* スマホでは p-3 にしてコンテンツ幅を確保、PCでは p-4 */
        class="retro-panel group flex items-center gap-3 md:gap-4 p-3 md:p-4 hover:border-[var(--accent-strong)] transition-colors"
      >
        <div class="w-12 h-12 shrink-0 flex items-center justify-center bg-[var(--bg-page)] overflow-hidden border border-[var(--border-color)]">
          {/* アイコンがない・読み込めないときは、名前の頭文字に差し替える */}
          {site.icon && (
            <img
              src={site.icon}
              alt=""
              width="48"
              height="48"
              class="w-full h-full object-cover"
              loading="lazy"
              onerror="this.hidden = true; this.nextElementSibling.hidden = false;"
            />
          )}
          <span class="text-lg font-bold text-[var(--accent-strong)]" aria-hidden="true" hidden={Boolean(site.icon)}>{site.name.charAt(0)}</span>
        </div>

        <div class="overflow-hidden min-w-0">
          {/* 見出しはサイト名、横に名前（敬称略）。サイト名がなければ名前だけ */}
          <h3 class="flex items-baseline gap-2 min-w-0">
            <span class="font-bold text-sm md:text-base text-[var(--text-main)] truncate group-hover:text-[var(--accent-strong)] transition-colors">
              {site.siteName || site.name}
            </span>
            {site.siteName && (
              <span class="mutual-owner shrink-0 text-xs text-[var(--text-muted)]">{site.name}</span>
            )}
          </h3>
          {/* 本人の紹介文。長いものは 2 行で省略し、カーソルを乗せると全文が出る */}
          {site.description && (
            <p class="mutual-desc text-xs text-[var(--text-main)] leading-relaxed line-clamp-2 mt-0.5" title={site.description}>
              {site.description}
            </p>
          )}
          <p class="text-[10px] text-[var(--text-muted)] font-mono truncate mt-0.5">
            {site.url.replace(/^https?:\/\//, '').replace(/\/$/, '')}
          </p>
        </div>
      </a>
    ))}
  </div>

  {/* 相互リンクしてくれる人向けに、このサイトの情報をコピーできるようにする */}
  <div class="retro-panel link-kit mt-6">
    <div class="link-kit-head">
      <img src="/favicon.png" alt="" width="40" height="40" />
      <div>
        <h3>このサイトへのリンク</h3>
        <p>相互リンク歓迎です。下の情報をご自由にお使いください。アイコンは直リンクOKです。</p>
      </div>
    </div>
    <dl class="link-kit-rows">
      {linkKit.map(row => (
        <div>
          <dt>{row.label}</dt>
          <dd>
            <code>{row.value}</code>
            <button type="button" data-copy={row.value} aria-label={`${row.label}をコピー`}>コピー</button>
          </dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<script is:inline>
  document.querySelectorAll('.link-kit [data-copy]').forEach(button => {
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy);
        button.textContent = 'コピーしました';
      } catch {
        button.textContent = 'コピーできませんでした';
      }
      setTimeout(() => { button.textContent = 'コピー'; }, 1500);
    });
  });
</script>