---
import { profile } from '../data/profile.js';
---

<header class="ticket-surface flex flex-col md:flex-row items-center md:items-stretch gap-6 p-5 md:p-6 mb-10 md:mb-12">
  <div class="ticket-perforation flex flex-col items-center justify-center gap-2 pr-6">
    <img
      src={profile.avatar}
      alt={`${profile.name}のアイコン`}
      class="pixel-avatar transition-transform duration-300 hover:scale-105"
    />
    <span class="ticket-label">PASSENGER</span>
  </div>

  <div class="flex-1 text-center md:text-left">
    <div class="flex flex-wrap justify-center md:justify-start gap-x-6 gap-y-1 mb-3">
      <span class="ticket-label">FROM: UOA</span>
      <span class="ticket-label">TO: THE WEB</span>
      <span class="ticket-label">ID: YONU33</span>
      <span class="ticket-label">EST. 2025.11.01</span>
    </div>
    <h1 class="text-3xl md:text-5xl font-bold tracking-tight text-[var(--text-main)] mb-3">
      {profile.name}
    </h1>
    <p class="text-base md:text-lg font-medium text-[var(--text-muted)] leading-relaxed">
      {profile.bio}
    </p>
    <p class="text-xs md:text-sm font-medium text-[var(--accent-strong)] mt-3 tracking-wide">
      {profile.role}
    </p>
  </div>
</header>