---
import { profile } from '../data/profile.js';
import githubSvg from '../assets/icons/github.svg?raw';
import xSvg from '../assets/icons/x.svg?raw';
import qiitaSvg from '../assets/icons/qiita.svg?raw';
import zennSvg from '../assets/icons/zenn.svg?raw';
import noteSvg from '../assets/icons/note.svg?raw';
// はてなブログの公式の小アイコンは Simple Icons にないので、ペンの形のアイコン（MDI fountain-pen-tip）で代用
import hatenaBlogSvg from '../assets/icons/hatenablog.svg?raw';
import discordSvg from '../assets/icons/discord.svg?raw';

// 切符の発券情報。仙台発、行き先は TBD（To Be Determined＝未定）、いまは会津で乗り継ぎ中。
// 狭い画面では項目の途中で折り返さず、「/」の位置でだけ折り返す
const ticketMeta = ['FROM: SENDAI', 'TO: TBD', 'TRANSIT: AIZU', 'ID: YONU33', 'ISSUE DATE: 2025.11.01'];
---

<header class="ticket-hero mb-12 md:mb-16">
  <div class="ticket-main">
    <div class="ticket-photo">
      {/* 狭い画面では「旅好きな／学生エンジニア」の位置でだけ改行する（<wbr> と word-break: keep-all） */}
      <span class="ticket-caption">旅好きな<wbr />学生エンジニア</span>
      <img src={profile.avatar} alt={`${profile.name}のアイコン`} />
    </div>
    <div class="ticket-name">
      <p class="ticket-meta-line">
        {ticketMeta.map((item, i) => (
          <Fragment>{i > 0 && ' / '}<span class="whitespace-nowrap">{item}</span></Fragment>
        ))}
      </p>
      <h1>yonu</h1>
      <p class="ticket-bio">{profile.bio}</p>
      <p class="ticket-role">{profile.role}</p>
    </div>
  </div>
  <nav class="ticket-socials" aria-label="SNSリンク">
    <a href="https://github.com/yonu33" target="_blank" rel="noopener noreferrer" title="GitHub" aria-label="GitHub"><Fragment set:html={githubSvg} /></a>
    <a href="https://x.com/i/user/1898003250068262912" target="_blank" rel="noopener noreferrer" title="X" aria-label="X"><Fragment set:html={xSvg} /></a>
    <a href="https://qiita.com/yonu" target="_blank" rel="noopener noreferrer" title="Qiita" aria-label="Qiita"><Fragment set:html={qiitaSvg} /></a>
    <a href="https://zenn.dev/yonu" target="_blank" rel="noopener noreferrer" title="Zenn" aria-label="Zenn"><Fragment set:html={zennSvg} /></a>
    <a href="https://note.com/yonu33" target="_blank" rel="noopener noreferrer" title="note" aria-label="note"><Fragment set:html={noteSvg} /></a>
    <a href="https://yonu.hatenablog.jp/" target="_blank" rel="noopener noreferrer" title="はてなブログ" aria-label="はてなブログ"><Fragment set:html={hatenaBlogSvg} /></a>
    <a href="https://discord.com/invite/9ZCgqNzqF7" target="_blank" rel="noopener noreferrer" title="Discord" aria-label="Discord"><Fragment set:html={discordSvg} /></a>
  </nav>
</header>