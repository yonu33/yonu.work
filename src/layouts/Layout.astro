---
import '../styles/global.css';
import ThemeIcon from '../components/ThemeIcon.astro';
const { title } = Astro.props;

const siteName = "yonu.work";
// 検索結果や SNS で共有したときに表示される説明文
const siteDescription = "会津大学の学生エンジニア yonu のポートフォリオ。作ったもの・活動の記録・記事をまとめています。";
const ogImage = "https://avatars.githubusercontent.com/u/175496140";
const pageTitle = title ? `${title} | ${siteName}` : siteName;

const discordEmbedColor = "#008578";

// 左サイドの目次（画面幅1280px以上で表示）。id はトップページのセクション id
const tocItems = [
  { id: 'top', name: 'TOP' },
  { id: 'profile', name: 'PROFILE' },
  { id: 'projects', name: 'PROJECTS' },
  { id: 'history', name: 'HISTORY' },
  { id: 'articles', name: 'ARTICLES' },
  { id: 'links', name: 'LINKS' },
];

// 右サイドの「次のセクション」はトップページでだけ出す
const isHome = Astro.url.pathname === '/';
---

<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{pageTitle}</title>

    <meta name="description" content={siteDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={siteDescription} />
    <meta property="og:image" content={ogImage} />

    <meta name="theme-color" content={discordEmbedColor} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@yonu33" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={siteDescription} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DotGothic16&display=swap" rel="stylesheet" />
    <script src="https://code.iconify.design/iconify-icon/2.1.0/iconify-icon.min.js"></script>
  
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      })();

      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>
  </head>
  <body class="bg-[var(--bg-page)] text-[var(--text-main)] font-sans antialiased min-h-screen transition-colors duration-300">
    <div id="travel-scene" class="travel-scene" aria-hidden="true">
      <div class="scene-sky"></div>
    </div>
    <!-- 左右の余白（1280px以上で表示）：左＝全セクションの目次、右＝次のセクション。
         現在地の強調と右の中身は index.astro のスクリプトが更新する -->
    <nav class="side-route side-left side-toc" aria-label="目次">
      <ol class="side-toc-list">
        {tocItems.map(item => (
          <li>
            <a href={`/#${item.id}`} data-toc-id={item.id}>
              <span class="side-toc-marker" aria-hidden="true"></span>
              <span>{item.name}</span>
            </a>
          </li>
        ))}
      </ol>
      <span class="side-line" aria-hidden="true"></span>
    </nav>
    {isHome && (
      <a id="scene-right-link" href="/#profile" class="side-route side-right">
        <span class="side-arrow" aria-hidden="true">→</span>
        <strong id="scene-right-main">PROFILE</strong>
        <span id="scene-right-sub">自分について</span>
        <span class="side-line" aria-hidden="true"></span>
      </a>
    )}
    <nav class="sticky top-0 z-50 bg-[var(--bg-card)] border-b border-[var(--border-color)]">
      <div class="mx-auto max-w-5xl px-5 md:px-8 h-14 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2 font-bold text-lg md:text-xl tracking-tight text-[var(--text-main)] shrink-0">
          <img src="/favicon.png" alt="" class="site-pixel-icon" />
          <span>yonu.work</span>
        </a>
        <div class="flex items-center">
          <ThemeIcon />
        </div>
      </div>
    </nav>
    <main class="mx-auto max-w-5xl px-5 md:px-8 pt-5 md:pt-8">
      <slot />
    </main>
    <nav class="section-dock" aria-label="ページ内リンク">
      <a href="/#top"><span aria-hidden="true"><iconify-icon icon="mdi:home-outline"></iconify-icon></span><strong>Top</strong></a>
      <a href="/#profile"><span aria-hidden="true"><iconify-icon icon="mdi:account-outline"></iconify-icon></span><strong>Profile</strong></a>
      <a href="/#projects"><span aria-hidden="true"><iconify-icon icon="mdi:view-grid-outline"></iconify-icon></span><strong>Projects</strong></a>
      <a href="/#history"><span aria-hidden="true"><iconify-icon icon="mdi:timeline-clock-outline"></iconify-icon></span><strong>History</strong></a>
      <a href="/#articles"><span aria-hidden="true"><iconify-icon icon="mdi:file-document-outline"></iconify-icon></span><strong>Articles</strong></a>
      <a href="/#links"><span aria-hidden="true"><iconify-icon icon="mdi:link-variant"></iconify-icon></span><strong>Links</strong></a>
    </nav>
  </body>
</html>