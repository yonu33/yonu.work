---
import '../styles/global.css';
import ThemeIcon from '../components/ThemeIcon.astro';
const { title } = Astro.props;

const siteName = "yonu.work";
// 検索結果や SNS で共有したときに表示される説明文
const siteDescription = "作って、仲間を集めて、ときどき旅に出る。旅好きな学生エンジニア、yonuのポートフォリオサイトです。";
// リンクを貼ったときの画像（1200×630）。作り直すときは `npm run og`（scripts/og/og.html を撮影する）
const ogImage = new URL('/og.png', Astro.site ?? 'https://yonu.work').href;
const ogImageAlt = "ドット絵の猫と「yonu」「作って、仲間を集めて、ときどき旅に出る。」「yonu.work」の文字";
const pageTitle = title ? `${title} | ${siteName}` : siteName;

const discordEmbedColor = "#008578";

// 左サイドの目次（画面幅1280px以上で表示）。id はトップページのセクション id
const tocItems = [
  { id: 'top', name: 'TOP' },
  { id: 'profile', name: 'PROFILE' },
  { id: 'projects', name: 'PROJECTS' },
  { id: 'history', name: 'HISTORY' },
  { id: 'articles', name: 'ARTICLES' },
  { id: 'links', name: 'LINKS' },
];

// スマホ・タブレット用の下部ナビ。icon は Material Design Icons（mdi）の SVG パス
const dockItems = [
  { name: 'Top', href: '/#top', icon: 'm12 5.69l5 4.5V18h-2v-6H9v6H7v-7.81zM12 3L2 12h3v8h6v-6h2v6h6v-8h3' }, // home-outline
  { name: 'Profile', href: '/#profile', icon: 'M12 4a4 4 0 0 1 4 4a4 4 0 0 1-4 4a4 4 0 0 1-4-4a4 4 0 0 1 4-4m0 2a2 2 0 0 0-2 2a2 2 0 0 0 2 2a2 2 0 0 0 2-2a2 2 0 0 0-2-2m0 7c2.67 0 8 1.33 8 4v3H4v-3c0-2.67 5.33-4 8-4m0 1.9c-2.97 0-6.1 1.46-6.1 2.1v1.1h12.2V17c0-.64-3.13-2.1-6.1-2.1' }, // account-outline
  { name: 'Projects', href: '/#projects', icon: 'M3 11h8V3H3m2 2h4v4H5m8 12h8v-8h-8m2 2h4v4h-4M3 21h8v-8H3m2 2h4v4H5m8-16v8h8V3m-2 6h-4V5h4Z' }, // view-grid-outline
  { name: 'History', href: '/#history', icon: 'M4 2v6H2V2zM2 22v-6h2v6zm3-10c0 1.11-.89 2-2 2a2 2 0 1 1 2-2m11-8c4.42 0 8 3.58 8 8s-3.58 8-8 8c-3.6 0-6.64-2.38-7.65-5.65L6 12l2.35-2.35C9.36 6.38 12.4 4 16 4m0 2c-3.31 0-6 2.69-6 6s2.69 6 6 6s6-2.69 6-6s-2.69-6-6-6m-1 7V8h1.5v4.2l3 1.8l-.82 1.26z' }, // timeline-clock-outline
  { name: 'Articles', href: '/#articles', icon: 'M6 2a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6zm0 2h7v5h5v11H6zm2 8v2h8v-2zm0 4v2h5v-2z' }, // file-document-outline
  { name: 'Links', href: '/#links', icon: 'M10.59 13.41c.41.39.41 1.03 0 1.42c-.39.39-1.03.39-1.42 0a5.003 5.003 0 0 1 0-7.07l3.54-3.54a5.003 5.003 0 0 1 7.07 0a5.003 5.003 0 0 1 0 7.07l-1.49 1.49c.01-.82-.12-1.64-.4-2.42l.47-.48a2.98 2.98 0 0 0 0-4.24a2.98 2.98 0 0 0-4.24 0l-3.53 3.53a2.98 2.98 0 0 0 0 4.24m2.82-4.24c.39-.39 1.03-.39 1.42 0a5.003 5.003 0 0 1 0 7.07l-3.54 3.54a5.003 5.003 0 0 1-7.07 0a5.003 5.003 0 0 1 0-7.07l1.49-1.49c-.01.82.12 1.64.4 2.43l-.47.47a2.98 2.98 0 0 0 0 4.24a2.98 2.98 0 0 0 4.24 0l3.53-3.53a2.98 2.98 0 0 0 0-4.24a.973.973 0 0 1 0-1.42' }, // link-variant
];

// 右サイドの「次のセクション」はトップページでだけ出す
const isHome = Astro.url.pathname === '/';
---

<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    {/* 検索結果のアイコン用。Google は 48px の倍数の正方形を推奨しているので 192×192 も用意する（背景透明） */}
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    {/* iPhone の「ホーム画面に追加」で使うアイコン（180×180、背景透明。iPhone では透明部分が黒になる） */}
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{pageTitle}</title>

    <meta name="description" content={siteDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={siteDescription} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />

    <meta name="theme-color" content={discordEmbedColor} />

    {/* 横長の OGP 画像を大きいカードで出す */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@yonu33" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={siteDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DotGothic16&display=swap" rel="stylesheet" />
  
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      })();

      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>
  </head>
  <body class="bg-[var(--bg-page)] text-[var(--text-main)] font-sans antialiased min-h-screen transition-colors duration-300">
    <div id="travel-scene" class="travel-scene" aria-hidden="true">
      <div class="scene-sky"></div>
    </div>
    {/* 左右の余白（1280px以上で表示）：左＝全セクションの目次、右＝次のセクション。
         現在地の強調と右の中身は index.astro のスクリプトが更新する */}
    <nav class="side-route side-left side-toc" aria-label="目次">
      <ol class="side-toc-list">
        {tocItems.map(item => (
          <li>
            <a href={`/#${item.id}`} data-toc-id={item.id}>
              <span class="side-toc-marker" aria-hidden="true"></span>
              <span>{item.name}</span>
            </a>
          </li>
        ))}
      </ol>
      <span class="side-line" aria-hidden="true"></span>
    </nav>
    {isHome && (
      <a id="scene-right-link" href="/#profile" class="side-route side-right">
        <span class="side-arrow" aria-hidden="true">→</span>
        <strong id="scene-right-main">PROFILE</strong>
        <span id="scene-right-sub">自分について</span>
        <span class="side-line" aria-hidden="true"></span>
      </a>
    )}
    <nav class="sticky top-0 z-50 bg-[var(--bg-card)] border-b border-[var(--border-color)]">
      <div class="mx-auto max-w-5xl px-5 md:px-8 h-14 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2 font-bold text-lg md:text-xl tracking-tight text-[var(--text-main)] shrink-0">
          <img src="/favicon.png" alt="" class="site-pixel-icon" />
          <span>yonu.work</span>
        </a>
        <div class="flex items-center">
          <ThemeIcon />
        </div>
      </div>
    </nav>
    <main class="mx-auto max-w-5xl px-5 md:px-8 pt-5 md:pt-8">
      <slot />
    </main>
    <nav class="section-dock" aria-label="ページ内リンク">
      {dockItems.map(item => (
        <a href={item.href}>
          <span aria-hidden="true">
            <svg width="1em" height="1em" viewBox="0 0 24 24" style="display:inline-block;vertical-align:-0.125em"><path fill="currentColor" d={item.icon} /></svg>
          </span>
          <strong>{item.name}</strong>
        </a>
      ))}
    </nav>
    {/* 詳細のポップアップなど、ページ全体より手前に出すもの。
         main の中に置くと main の重なり順（z-index: 10）に閉じ込められ、ヘッダーや下部バーより下になってしまう */}
    <slot name="overlay" />
  </body>
</html>